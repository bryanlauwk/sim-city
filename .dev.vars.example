# CITY_MODEL="claude-sonnet-5"

# Optional: on-demand actors generated with Meshy and shared through Supabase
# MESHY_API_KEY="msy_..."
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."
# MESHY_DAILY_CAP="20"
# MESHY_PER_VISITOR_CAP="2"
